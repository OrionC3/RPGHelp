{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "secret phrase its secret phrase secret phrase its secret",
    "Issuer": "RPGHelp Jwt",
    "Audience": "RPGHelp Jwt Client"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "RealIpHeader": "X-Real-Ip",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429, // select the error code
    "GeneralRules": [
      {
        "Endpoint": "*", // * first
        "Period": "1s", // Time limit for request
        "Limit": 30 // Max 30 request for 1ms
      },
      {
        "Endpoint": ":/api/Campagn", // path after endpoint (/api/Campagn) for example
        "Pedior": "1s",
        "Limit": 5
      },
      {
        "Endpoint": ":/api/User/login",
        "Period": "1s", // Time limit for request
        "Limit": 5 // Max 30 request for 1ms
      }
    ]
  }
}
